{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": false,
  "redirects": [
    { "source": "/soy-nuevo", "destination": "/soy-nuevo.html", "permanent": true },
    { "source": "/soy-nuevo/", "destination": "/soy-nuevo.html", "permanent": true },
    { "source": "/galeria", "destination": "/galeria.html", "permanent": true },
    { "source": "/galeria/", "destination": "/galeria.html", "permanent": true },
    { "source": "/donaciones", "destination": "/donaciones.html", "permanent": true },
    { "source": "/donaciones/", "destination": "/donaciones.html", "permanent": true },
    { "source": "/comunidad", "destination": "/comunidad.html", "permanent": true },
    { "source": "/comunidad/", "destination": "/comunidad.html", "permanent": true },
    { "source": "/contacto", "destination": "/contacto.html", "permanent": true },
    { "source": "/contacto/", "destination": "/contacto.html", "permanent": true },
    { "source": "/sample-page", "destination": "/index.html", "permanent": true },
    { "source": "/sample-page/", "destination": "/index.html", "permanent": true }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
